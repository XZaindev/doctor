# .env.example
# Copy this file to .env and fill in your actual credentials

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these values from your Supabase project settings

# Supabase Project URL
# Found at: Settings → General → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public)
# Found at: Settings → API → Project API keys → anon (public)
SUPABASE_ANON_KEY=your-anon-key-here-starts-with-eyJ

# ============================================
# APP CONFIGURATION
# ============================================

# API Timeout (milliseconds)
API_TIMEOUT=30000

# Enable Debug Mode
DEBUG_MODE=false

# ============================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================

# Firebase Analytics (if using Firebase)
# FIREBASE_PROJECT_ID=your-firebase-project

# Sentry Error Tracking (if using Sentry)
# SENTRY_DSN=your-sentry-dsn

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. .env file is in .gitignore
# 3. Each developer should have their own .env file
# 4. For production, use environment variables from your deployment platform
#    (e.g., GitHub Secrets, Heroku Config Vars, Firebase Hosting Environment)
# 5. Never share your ANON_KEY publicly
# 6. For extra security in production, use Service Role Key with proper RLS policies
